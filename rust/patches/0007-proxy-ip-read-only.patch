 use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
 use tracing::{debug, info};
 
+tokio::task_local! {
+    static READ_ONLY_PROBE: ();
+}
+
+/// Runs a diagnostic using the group's normal candidate selection without committing group state.
+pub async fn with_read_only_probe<T>(dial: impl Future<Output = T>) -> T {
+    READ_ONLY_PROBE.scope((), dial).await
+}
+
+pub(crate) fn read_only_probe() -> bool {
+    READ_ONLY_PROBE.try_with(|_| ()).is_ok()
+}
+
+pub(crate) const PROBE_BLOCKED: &str = "blocked by proxy IP probe outbound";
+
+pub fn probe_blocked(error: &MeowError) -> bool {
+    match error {
+        MeowError::Other(message) => message == PROBE_BLOCKED,
+        MeowError::RelayHopFailed { source, .. } => probe_blocked(source),
+        _ => false,
+    }
+}

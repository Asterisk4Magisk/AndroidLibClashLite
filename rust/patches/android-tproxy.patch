+//! Android DNS outbound: wire-format queries share the tunnel's live resolver.
+use async_trait::async_trait;
+use meow_common::adapter::ProxyHealth;
+use meow_common::error::{MeowError, Result};
+use meow_common::{AdapterType, Metadata, ProxyAdapter, ProxyConn, ProxyPacketConn};
+use meow_dns::{DnsServer, ResolverSlot};
+use std::{
+    io,
+    net::SocketAddr,
+    pin::Pin,
+    task::{Context, Poll},
+    time::Duration,
+};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, ReadBuf};
+use tokio::sync::{mpsc, watch, Mutex};
+
+pub async fn serve_tcp<S: AsyncRead + AsyncWrite + Unpin>(
+    mut stream: S,
+    slot: ResolverSlot,
+) -> io::Result<()> {
+    loop {
+        let work = async {
+            let size = stream.read_u16().await?;
+            let mut query = vec![0; usize::from(size)];
+            stream.read_exact(&mut query).await?;
+            let resolver = slot.read().clone();
+            let response = DnsServer::handle_query(&query, &resolver)
+                .await
+                .map_err(io::Error::other)?;
+            let size = u16::try_from(response.len()).map_err(io::Error::other)?;
+            stream.write_u16(size).await?;
+            stream.write_all(&response).await?;
+            stream.flush().await
+        };
+        tokio::time::timeout(Duration::from_secs(30), work).await??;
+    }
+}
+
+pub struct DnsAdapter {
+    name: String,
+    slot: Option<ResolverSlot>,
+    health: ProxyHealth,
+}
+impl DnsAdapter {
+    pub fn new(name: &str, slot: Option<ResolverSlot>) -> Self {
+        Self {
+            name: name.into(),
+            slot,
+            health: ProxyHealth::new(),
+        }
+    }
+    fn resolver(&self) -> Result<ResolverSlot> {
+        self.slot
+            .clone()
+            .ok_or_else(|| MeowError::Dns("DNS outbound cannot bootstrap its own resolver".into()))
+    }
+}
+#[async_trait]
+impl ProxyAdapter for DnsAdapter {
+    fn name(&self) -> &str {
+        &self.name
+    }
+    fn adapter_type(&self) -> AdapterType {
+        AdapterType::Dns
+    }
+    fn addr(&self) -> &str {
+        ""
+    }
+    fn support_udp(&self) -> bool {
+        true
+    }
+    fn health(&self) -> &ProxyHealth {
+        &self.health
+    }
+    async fn dial_tcp(&self, _: &Metadata) -> Result<Box<dyn ProxyConn>> {
+        let slot = self.resolver()?;
+        let (client, server) = tokio::io::duplex(65536);
+        let task = tokio::spawn(async move {
+            let _ = serve_tcp(server, slot).await;
+        });
+        Ok(Box::new(DnsStream {
+            stream: client,
+            task,
+        }))
+    }
+    async fn dial_udp(&self, _: &Metadata) -> Result<Box<dyn ProxyPacketConn>> {
+        let (tx, rx) = mpsc::channel(64);
+        let (closed, _) = watch::channel(false);
+        Ok(Box::new(DnsPacket {
+            slot: self.resolver()?,
+            tx,
+            rx: Mutex::new(rx),
+            closed,
+        }))
+    }
+}
+struct DnsStream {
+    stream: tokio::io::DuplexStream,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Drop for DnsStream {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+impl ProxyConn for DnsStream {}
+impl AsyncRead for DnsStream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_read(cx, buf)
+    }
+}
+impl AsyncWrite for DnsStream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.stream).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.stream).poll_shutdown(cx)
+    }
+}
+struct DnsPacket {
+    slot: ResolverSlot,
+    tx: mpsc::Sender<(Vec<u8>, SocketAddr)>,
+    rx: Mutex<mpsc::Receiver<(Vec<u8>, SocketAddr)>>,
+    closed: watch::Sender<bool>,
+}
+#[async_trait]
+impl ProxyPacketConn for DnsPacket {
+    async fn read_packet(&self, buf: &mut [u8]) -> Result<(usize, SocketAddr)> {
+        let mut closed = self.closed.subscribe();
+        let mut rx = self.rx.lock().await;
+        let packet = tokio::select! {
+            _ = closed.wait_for(|v| *v) => None,
+            value = rx.recv() => value,
+        }
+        .ok_or_else(|| io::Error::from(io::ErrorKind::BrokenPipe))?;
+        if packet.0.len() > buf.len() {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput).into());
+        }
+        buf[..packet.0.len()].copy_from_slice(&packet.0);
+        Ok((packet.0.len(), packet.1))
+    }
+    async fn write_packet(&self, buf: &[u8], addr: &SocketAddr) -> Result<usize> {
+        let resolver = self.slot.read().clone();
+        let mut closed = self.closed.subscribe();
+        tokio::select! {
+            _ = closed.wait_for(|v| *v) => Err(io::Error::from(io::ErrorKind::BrokenPipe).into()),
+            result = async {
+                let response = tokio::time::timeout(Duration::from_secs(5), DnsServer::handle_query(buf, &resolver))
+                    .await.map_err(io::Error::other)?.map_err(io::Error::other)?;
+                self.tx.send((response, *addr)).await.map_err(io::Error::other)?;
+                Ok(buf.len())
+            } => result,
+        }
+    }
+    fn local_addr(&self) -> Result<SocketAddr> {
+        Ok(SocketAddr::from(([0, 0, 0, 0], 0)))
+    }
+    fn close(&self) -> Result<()> {
+        self.closed.send_replace(true);
+        Ok(())
+    }
+}

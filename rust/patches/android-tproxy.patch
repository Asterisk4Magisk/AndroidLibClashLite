+/// Android primary subscription download: credentials stay scoped to the origin.
+pub async fn fetch_subscription(
+    url: &str,
+    proxy: Option<&Arc<dyn Proxy>>,
+    headers: &[(String, String)],
+) -> Result<Response> {
+    let mut current = Url::parse(url)?;
+    let mut headers = headers.to_vec();
+    for _ in 0..=10 {
+        match fetch_one(&current, proxy, &headers, MAX_BODY_BYTES).await? {
+            Outcome::Body(response) => return Ok(response),
+            Outcome::Redirect(next) => {
+                let next = current.join(&next)?;
+                if current.scheme() == "https" && next.scheme() != "https" {
+                    bail!("HTTPS subscription redirect downgrade is not allowed");
+                }
+                if current.origin() != next.origin() {
+                    headers.retain(|(name, _)| {
+                        !name.eq_ignore_ascii_case("x-hwid")
+                            && !name.eq_ignore_ascii_case("authorization")
+                    });
+                }
+                current = next;
+            }
+        }
+    }
+    bail!("too many subscription redirects")
 }
 

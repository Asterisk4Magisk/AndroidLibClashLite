+//! ROOT attribution without a JVM. VPN uses the inbound Android callbacks.
+use super::{Network, ProcessInfo, SocketAddr};
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+pub fn find_process(network: Network, local: SocketAddr) -> Option<ProcessInfo> {
+    if unsafe { libc::geteuid() } != 0 {
+        return None;
+    }
+    let protocol = match network {
+        Network::Tcp => "tcp",
+        Network::Udp => "udp",
+    };
+    let uid = [
+        format!("/proc/net/{protocol}6"),
+        format!("/proc/net/{protocol}"),
+    ]
+    .iter()
+    .filter_map(|path| std::fs::read_to_string(path).ok())
+    .find_map(|table| socket_uid(&table, local))?;
+    let packages = std::fs::read_to_string("/data/system/packages.list").unwrap_or_default();
+    let name = packages
+        .lines()
+        .find_map(|line| {
+            let mut fields = line.split_whitespace();
+            let package = fields.next()?;
+            let app_id = fields.next()?.parse::<u32>().ok()?;
+            (app_id == uid % 100000).then(|| package.to_owned())
+        })
+        .unwrap_or_default();
+    Some(ProcessInfo {
+        name,
+        path: String::new(),
+        uid: Some(uid),
+    })
+}
+
+fn socket_uid(table: &str, local: SocketAddr) -> Option<u32> {
+    let mut wildcard = None;
+    for line in table.lines().skip(1) {
+        let fields: Vec<_> = line.split_whitespace().collect();
+        if fields.len() < 8 {
+            continue;
+        }
+        let Some((ip, port)) = fields[1].split_once(':') else {
+            continue;
+        };
+        if u16::from_str_radix(port, 16).ok() != Some(local.port()) {
+            continue;
+        }
+        let Some(ip) = proc_ip(ip) else {
+            continue;
+        };
+        let Some(uid) = fields[7].parse().ok() else {
+            continue;
+        };
+        if ip.to_canonical() == local.ip().to_canonical() {
+            return Some(uid);
+        }
+        if ip.is_unspecified() {
+            wildcard = Some(uid);
+        }
+    }
+    wildcard
+}
+
+fn proc_ip(raw: &str) -> Option<IpAddr> {
+    let mut bytes = Vec::new();
+    for chunk in raw.as_bytes().chunks_exact(8) {
+        let word = u32::from_str_radix(std::str::from_utf8(chunk).ok()?, 16).ok()?;
+        bytes.extend_from_slice(&word.to_ne_bytes());
+    }
+    match raw.len() {
+        8 => Some(Ipv4Addr::from(<[u8; 4]>::try_from(bytes).ok()?).into()),
+        32 => Some(Ipv6Addr::from(<[u8; 16]>::try_from(bytes).ok()?).into()),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn android_uid_from_proc_tables() {
+        let table = "header\n0: 0100007F:1234 00000000:0000 01 0:0 0:0 0 10123 0 1";
+        assert_eq!(
+            socket_uid(table, "127.0.0.1:4660".parse().unwrap()),
+            Some(10123)
+        );
+        assert_eq!(socket_uid(table, "127.0.0.1:4661".parse().unwrap()), None);
+        assert_eq!(
+            proc_ip("0000000000000000FFFF00000100007F")
+                .unwrap()
+                .to_canonical(),
+            "127.0.0.1".parse::<IpAddr>().unwrap()
+        );
+    }
+}

@@ -0,0 +1,29 @@
+//! Physical-network resolver snapshots supplied by an Android embedder.
+use std::{
+    net::SocketAddr,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc, LazyLock, RwLock,
+    },
+};
+
+static SERVERS: LazyLock<RwLock<Option<Arc<Vec<SocketAddr>>>>> = LazyLock::new(|| {
+    RwLock::new(if cfg!(target_os = "android") {
+        Some(Arc::new(Vec::new()))
+    } else {
+        None
+    })
+});
+static GENERATION: AtomicUsize = AtomicUsize::new(0);
+
+pub fn update(servers: Vec<SocketAddr>) {
+    *SERVERS.write().unwrap() = Some(Arc::new(servers));
+    GENERATION.fetch_add(1, Ordering::AcqRel);
+    crate::reset_pooled_connections();
+}
+pub fn servers() -> Option<Arc<Vec<SocketAddr>>> {
+    SERVERS.read().unwrap().clone()
+}
+pub(crate) fn generation() -> usize {
+    GENERATION.load(Ordering::Acquire)
+}

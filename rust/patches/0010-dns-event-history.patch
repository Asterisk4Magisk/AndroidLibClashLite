+        }
+        let mut labels = &data[12..data.len() - 4];
+        while let Some((&length, rest)) = labels.split_first() {
+            if length == 0 {
+                break;
+            }
+            let (label, remaining) = rest.split_at(usize::from(length));
+            if !label
+                .iter()
+                .all(|byte| byte.is_ascii_alphanumeric() || *byte == b'-')
+            {
+                return;
+            }
+            labels = remaining;
+        }
+        let mut name = String::with_capacity(domain.len() + 1);
+        name.push_str(domain);
+        name.push('.');
+        value.borrow_mut().question = Some(Question::Parsed { name, qtype });
+    });
+}

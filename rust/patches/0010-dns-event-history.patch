+/// Serve an intercepted TCP DNS flow against its live resolver slot.
+pub async fn serve_tcp_with_uid_lookup<S: AsyncRead + AsyncWrite + Unpin>(
+    mut stream: S,
+    slot: ResolverSlot,
+    mut owner: impl FnMut() -> crate::events::QueryUid,
+) -> std::io::Result<()> {
+    loop {
+        let deadline = tokio::time::Instant::now() + TCP_EXCHANGE_TIMEOUT;
+        let Some(query) =
+            tokio::time::timeout_at(deadline, read_dns_frame(&mut stream, u16::MAX.into()))
+                .await??
+        else {
+            return stream.shutdown().await;
+        };
+        let resolver = Arc::clone(&slot.read().resolver);
+        let response = DnsServer::handle_query_with_deadline(&query, &resolver, owner(), deadline)
+            .await
+            .map_err(std::io::Error::other)?;
+        tokio::time::timeout_at(deadline, write_dns_frame(&mut stream, &response)).await??;
+    }
+}

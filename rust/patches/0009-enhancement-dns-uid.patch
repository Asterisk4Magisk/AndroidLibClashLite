+type EnhancedUidLookup = fn(bool, std::net::SocketAddr, std::net::SocketAddr, &[u8]) -> Option<u32>;
+static ENHANCED_UID_LOOKUP: std::sync::OnceLock<EnhancedUidLookup> = std::sync::OnceLock::new();
+
+pub fn set_enhanced_uid_lookup(lookup: EnhancedUidLookup) {
+    let _ = ENHANCED_UID_LOOKUP.set(lookup);
+}
+
+pub fn enhanced_uid(
+    tcp: bool,
+    source: Option<std::net::SocketAddr>,
+    destination: Option<std::net::SocketAddr>,
+    query: &[u8],
+    fallback: Option<u32>,
+) -> Option<u32> {
+    if let (Some(lookup), Some(source), Some(destination)) =
+        (ENHANCED_UID_LOOKUP.get(), source, destination)
+    {
+        if enabled() {
+            if let Some(uid) = lookup(tcp, source, destination, query) {
+                return (uid != u32::MAX).then_some(uid);
+            }
+        }
+    }
+    fallback
 }
 

diff --git a/crates/meow-dns/src/events.rs b/crates/meow-dns/src/events.rs
new file mode 100644
index 0000000..eaf5760
--- /dev/null
+++ b/crates/meow-dns/src/events.rs
@@ -0,0 +1,350 @@
+//! Structured events for client DNS requests. The controller subscribes to a
+//! bounded feed so publishing an event never waits for an HTTP reader.
+use crate::client::DnsClient;
+use hickory_proto::rr::rdata::svcb::{SvcParamValue, SVCB};
+use hickory_proto::{
+    op::{Message, MessageType, OpCode},
+    rr::RData,
+};
+use serde::Serialize;
+use std::{
+    cell::RefCell,
+    fmt::Write as _,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc, LazyLock, Mutex,
+    },
+    time::{Instant, SystemTime, UNIX_EPOCH},
+};
+use tokio::{
+    sync::{broadcast, oneshot},
+    time,
+};
+
+#[derive(Clone)]
+pub(crate) struct Upstream(pub(crate) Arc<DnsClient>);
+
+impl std::fmt::Debug for Upstream {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_tuple("Upstream")
+            .field(&self.0.upstream_label())
+            .finish()
+    }
+}
+
+pub(crate) fn set_client(client: &DnsClient) {
+    if enabled() {
+        let _ = ORIGIN.try_with(|value| *value.borrow_mut() = client.event_origin());
+    }
+}
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Origin {
+    pub source: Option<&'static str>,
+    pub upstream: Option<String>,
+    pub route: Option<&'static str>,
+    pub outbound_tag: Option<String>,
+}
+
+#[derive(Clone, Serialize)]
+struct Answer {
+    name: String,
+    #[serde(rename = "type")]
+    record_type: u16,
+    data: String,
+}
+
+#[derive(Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Event {
+    seq: u64,
+    time: u64,
+    delay: u64,
+    qname: String,
+    qtype: u16,
+    status: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    rcode: Option<u16>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    answers: Option<Vec<Answer>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    answer_source: Option<&'static str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    upstream: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    route: Option<&'static str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    outbound_tag: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    uid: Option<u32>,
+}
+
+static FEED: LazyLock<Mutex<(u64, broadcast::Sender<Event>)>> =
+    LazyLock::new(|| Mutex::new((0, broadcast::channel(64).0)));
+static SUBSCRIBERS: AtomicUsize = AtomicUsize::new(0);
+
+pub fn enabled() -> bool {
+    SUBSCRIBERS.load(Ordering::Relaxed) != 0
+}
+
+pub struct Subscription {
+    receiver: broadcast::Receiver<Event>,
+}
+
+impl Subscription {
+    pub async fn recv(&mut self) -> Option<Event> {
+        loop {
+            match self.receiver.recv().await {
+                Ok(event) => return Some(event),
+                Err(broadcast::error::RecvError::Lagged(_)) => continue,
+                Err(broadcast::error::RecvError::Closed) => return None,
+            }
+        }
+    }
+}
+
+impl Drop for Subscription {
+    fn drop(&mut self) {
+        SUBSCRIBERS.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+pub fn subscribe() -> Subscription {
+    let receiver = FEED.lock().expect("DNS event feed").1.subscribe();
+    SUBSCRIBERS.fetch_add(1, Ordering::Relaxed);
+    Subscription { receiver }
+}
+
+tokio::task_local! {
+    pub(crate) static ORIGIN: RefCell<Origin>;
+}
+
+pub(crate) fn set_origin(origin: Origin) {
+    if enabled() {
+        let _ = ORIGIN.try_with(|value| *value.borrow_mut() = origin);
+    }
+}
+
+pub(crate) fn source(source: &'static str) {
+    set_origin(Origin {
+        source: Some(source),
+        ..Origin::default()
+    });
+}
+
+pub enum QueryUid {
+    Known(Option<u32>),
+    Pending {
+        receiver: oneshot::Receiver<Option<u32>>,
+        deadline: time::Instant,
+    },
+}
+
+pub(crate) fn finish(
+    start: Instant,
+    query: &[u8],
+    response: Option<&[u8]>,
+    uid: QueryUid,
+    timed_out: bool,
+) {
+    if !enabled() {
+        return;
+    }
+    let completed = SystemTime::now();
+    let delay = start.elapsed().as_millis() as u64;
+    let Ok(query) = Message::from_vec(query) else {
+        return;
+    };
+    if query.metadata.message_type != MessageType::Query || query.metadata.op_code != OpCode::Query
+    {
+        return;
+    }
+    let Some(question) = query.queries.first() else {
+        return;
+    };
+    let response = response.and_then(|bytes| Message::from_vec(bytes).ok());
+    let origin = ORIGIN.with(|origin| origin.take());
+    let mut event = Event {
+        seq: 0,
+        time: completed
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis() as u64,
+        delay,
+        qname: question.name.to_ascii(),
+        qtype: u16::from(question.query_type),
+        status: if response.is_some() {
+            "answered"
+        } else if timed_out {
+            "timeout"
+        } else {
+            "failed"
+        },
+        rcode: response
+            .as_ref()
+            .map(|msg| u16::from(msg.metadata.response_code)),
+        answers: response.map(|msg| {
+            msg.answers
+                .iter()
+                .map(|rr| Answer {
+                    name: rr.name.to_ascii(),
+                    record_type: u16::from(rr.record_type()),
+                    data: record_data(&rr.data),
+                })
+                .collect()
+        }),
+        answer_source: origin.source,
+        upstream: origin.upstream.as_deref().and_then(upstream_address),
+        route: origin.route,
+        outbound_tag: origin.outbound_tag,
+        uid: None,
+    };
+    match uid {
+        QueryUid::Known(uid) => event.uid = uid,
+        QueryUid::Pending {
+            mut receiver,
+            deadline,
+        } => match receiver.try_recv() {
+            Ok(uid) => event.uid = uid,
+            Err(oneshot::error::TryRecvError::Empty) => {
+                tokio::spawn(async move {
+                    event.uid = time::timeout_at(deadline, receiver)
+                        .await
+                        .ok()
+                        .and_then(Result::ok)
+                        .flatten();
+                    publish(event);
+                });
+                return;
+            }
+            Err(oneshot::error::TryRecvError::Closed) => {}
+        },
+    }
+    publish(event);
+}
+
+fn publish(mut event: Event) {
+    if !enabled() {
+        return;
+    }
+    let mut feed = FEED.lock().expect("DNS event feed");
+    feed.0 += 1;
+    event.seq = feed.0;
+    let _ = feed.1.send(event);
+}
+
+fn record_data(data: &RData) -> String {
+    let mut text = String::new();
+    match data {
+        RData::TXT(txt) => {
+            for (index, chunk) in txt.txt_data.iter().enumerate() {
+                if index != 0 {
+                    text.push(' ');
+                }
+                write_character_string(&mut text, chunk);
+            }
+        }
+        RData::HINFO(info) => {
+            write_character_string(&mut text, &info.cpu);
+            text.push(' ');
+            write_character_string(&mut text, &info.os);
+        }
+        RData::SVCB(service) => return service_data(service),
+        RData::HTTPS(service) => return service_data(&service.0),
+        _ => return data.to_string(),
+    }
+    text
+}
+
+fn write_character_string(text: &mut String, bytes: &[u8]) {
+    text.push('"');
+    write_escaped_bytes(text, bytes, b"\"\\");
+    text.push('"');
+}
+
+fn write_escaped_bytes(text: &mut String, bytes: &[u8], special: &[u8]) {
+    for &byte in bytes {
+        if special.contains(&byte) {
+            text.push('\\');
+            text.push(char::from(byte));
+        } else if (b' '..=b'~').contains(&byte) {
+            text.push(char::from(byte));
+        } else {
+            let _ = write!(text, "\\{byte:03}");
+        }
+    }
+}
+
+fn write_comma_list(text: &mut String, values: &[impl std::fmt::Display]) {
+    for (index, value) in values.iter().enumerate() {
+        if index != 0 {
+            text.push(',');
+        }
+        let _ = write!(text, "{value}");
+    }
+}
+
+fn service_data(service: &SVCB) -> String {
+    let mut text = format!("{} {}", service.svc_priority, service.target_name);
+    for (key, value) in &service.svc_params {
+        let key = match u16::from(*key) {
+            7 => "dohpath".to_owned(),
+            8 => "ohttp".to_owned(),
+            _ => key.to_string(),
+        };
+        let _ = write!(text, " {key}=\"");
+        match value {
+            SvcParamValue::Mandatory(values) => write_comma_list(&mut text, &values.0),
+            SvcParamValue::Alpn(values) => {
+                for (index, value) in values.0.iter().enumerate() {
+                    if index != 0 {
+                        text.push(',');
+                    }
+                    for byte in value.bytes() {
+                        match byte {
+                            b',' => text.push_str(r"\\\044"),
+                            b'\\' => text.push_str(r"\\\092"),
+                            _ => write_escaped_bytes(&mut text, &[byte], b"\"; "),
+                        }
+                    }
+                }
+            }
+            SvcParamValue::Ipv4Hint(values) => write_comma_list(&mut text, &values.0),
+            SvcParamValue::Ipv6Hint(values) => write_comma_list(&mut text, &values.0),
+            SvcParamValue::Unknown(value) => write_escaped_bytes(&mut text, &value.0, b"\";\\"),
+            _ => {
+                let _ = write!(text, "{value}");
+            }
+        }
+        text.push('"');
+    }
+    text
+}
+
+fn upstream_address(label: &str) -> Option<String> {
+    if let Some((scheme, endpoint)) = label.split_once("://") {
+        let authority = endpoint.split(['/', '?', '#']).next()?.rsplit('@').next()?;
+        return (!authority.is_empty()).then(|| format!("{scheme}://{authority}"));
+    }
+    (!label.is_empty()
+        && label
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || b".:-[]".contains(&c)))
+    .then(|| label.to_owned())
+}
+
+tokio::task_local! {
+    static OUTBOUND_UID: u32;
+}
+
+pub async fn with_outbound_uid<F: std::future::Future>(uid: Option<u32>, work: F) -> F::Output {
+    match uid {
+        Some(uid) => OUTBOUND_UID.scope(uid, work).await,
+        None => work.await,
+    }
+}
+
+pub(crate) fn outbound_uid() -> Option<u32> {
+    OUTBOUND_UID.try_with(|uid| *uid).ok()
+}

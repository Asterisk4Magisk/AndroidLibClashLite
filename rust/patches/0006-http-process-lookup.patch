+//! Optional process attribution supplied by an embedded runtime.
+use meow_common::{process_lookup::ProcessInfo, Metadata};
+use meow_tunnel::tunnel::TunnelInner;
+use parking_lot::RwLock;
+use std::{future::Future, net::SocketAddr, pin::Pin};
+
+pub type ProcessLookupFuture = Pin<Box<dyn Future<Output = Option<ProcessInfo>> + Send>>;
+pub type TcpProcessLookup = fn(&TunnelInner, SocketAddr, SocketAddr) -> ProcessLookupFuture;
+
+static TCP_PROCESS_LOOKUP: RwLock<Option<TcpProcessLookup>> = RwLock::new(None);
+
+/// Install or remove the embedder's lookup for accepted proxy sockets.
+pub fn set_tcp_process_lookup(lookup: Option<TcpProcessLookup>) {
+    *TCP_PROCESS_LOOKUP.write() = lookup;
+}
+
+pub(crate) async fn enrich_tcp_process(
+    inner: &TunnelInner,
+    metadata: &mut Metadata,
+    source: SocketAddr,
+    destination: SocketAddr,
+) {
+    let lookup = *TCP_PROCESS_LOOKUP.read();
+    let Some(lookup) = lookup else {
+        return;
+    };
+    // Unknown and deliberately disabled results are authoritative too.
+    metadata.process_info_complete = true;
+    if let Some(info) = lookup(inner, source, destination).await {
+        metadata.process = info.name.into();
+        metadata.process_path = info.path.into();
+        metadata.uid = info.uid;
+    }
+}
